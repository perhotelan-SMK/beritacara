        function drawSampleSignature(canvasId, type) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;

            const rect = canvas.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            const w = rect.width > 0 ? rect.width : (canvas.offsetWidth || 400);
            const h = rect.height > 0 ? rect.height : (canvas.offsetHeight || 150);

            canvas.width = Math.max(1, Math.round(w * dpr));
            canvas.height = Math.max(1, Math.round(h * dpr));

            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            ctx.lineWidth = 2.5 * dpr;
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#0284c7';

            const cw = canvas.width;
            const ch = canvas.height;

            ctx.beginPath();
            ctx.moveTo(cw * 0.15, ch * 0.5);
            ctx.bezierCurveTo(cw * 0.25, ch * 0.15, cw * 0.35, ch * 0.85, cw * 0.5, ch * 0.4);
            ctx.bezierCurveTo(cw * 0.6, ch * 0.1, cw * 0.75, ch * 0.75, cw * 0.85, ch * 0.5);
            ctx.stroke();

            const placeholder = document.getElementById(`placeholder-${type}`);
            if (placeholder) placeholder.style.display = 'none';

            saveSignatureData(canvas, type);
        }

        function getDayName(dateString) {
            if (!dateString) return 'Senin';
            const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
            const d = new Date(dateString);
            return isNaN(d.getDay()) ? 'Senin' : days[d.getDay()];
        }

        function updateLivePreview() {
