    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        serif: ['Times New Roman', 'Times', 'serif'],
                        garamond: ['Cormorant Garamond', 'Times New Roman', 'serif'],
                        cinzel: ['Cinzel', 'serif'],
                        balinese: ['Noto Serif Balinese', 'Times New Roman', 'serif']
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        /* Canvas Signature Styling */
        .sig-canvas {
            border: 2px dashed #475569;
            border-radius: 0.75rem;
            background-color: #0f172a;
            cursor: crosshair;
            touch-action: none;
        }
        .sig-canvas.active {
            border-color: #22c55e;
            background-color: #1e293b;
        }

        /* Printable Document Dimensions & Aesthetic Enhancements */
        .a4-paper {
            width: 210mm;
            min-height: 297mm;
            background: #ffffff;
            color: #0f172a;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            margin: 0 auto;
            padding: 15mm 18mm 18mm 18mm;
            box-sizing: border-box;
            font-family: 'Times New Roman', Times, serif;
            position: relative;
            background-image: radial-gradient(#cbd5e1 0.75px, transparent 0.75px);
            background-size: 24px 24px;
        }

        /* Formal Border Frame Variants */
        .paper-frame-double {
            border: 1px solid #0f172a;
            outline: 3px double #0f172a;
            outline-offset: 4px;
        }

        .paper-frame-ornament {
            border: 2px solid #1e293b;
            padding: 12mm 14mm !important;
            position: relative;
        }
        .paper-frame-ornament::before {
            content: '';
            position: absolute;
            inset: 6px;
            border: 1px solid #64748b;
            pointer-events: none;
        }

        /* Official Watermark Background */
        .doc-watermark {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: none;
            opacity: 0.045;
            user-select: none;
            z-index: 0;
            overflow: hidden;
        }

        /* Print Override */
        @media print {
            body {
                background: white !important;
                color: black !important;
            }
            body * {
                visibility: hidden;
            }
            #pdf-document-paper, #pdf-document-paper * {
                visibility: visible;
            }
            #pdf-document-paper {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                margin: 0;
                padding: 10mm 12mm;
                box-shadow: none !important;
                background-image: none !important;
            }
            .no-print {
                display: none !important;
            }
        }
        
        @media (max-width: 880px) {
            .a4-container {
                overflow-x: auto;
            }
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-full flex flex-col selection:bg-emerald-500 selection:text-slate-950">

