            const tanggalKegiatan = document.getElementById('tanggalKegiatan')?.value || '2026-09-21';
            const kotaTerbit = document.getElementById('kotaTerbit')?.value || 'Karangasem';
            const tujuan = document.getElementById('tujuan')?.value || 'Monitoring siswa PKL siswa';
            const namaDudi = document.getElementById('namaDudi')?.value || 'Atyana';
            const alamatDudi = document.getElementById('alamatDudi')?.value || 'Jalan Karangasem-Denpasar, Candi Dasa, Manggis';
            const catatan = document.getElementById('catatan')?.value || 'Monitoring dilakukan dengan baik, tanpa ada permasalahan siswa.';
            const namaInstruktur = document.getElementById('namaInstruktur')?.value || 'I Nyoman Tombos';
            const namaPembimbing = document.getElementById('namaPembimbing')?.value || namaGuru;

            const formatNoSuratPreview = document.getElementById('formatNoSuratPreview');
            if (formatNoSuratPreview) formatNoSuratPreview.innerText = nomorSurat;

            const docNomor = document.getElementById('doc-nomor');
            if (docNomor) docNomor.innerText = nomorSurat;

            const tglLengkap = formatIndonesianDate(tanggalKegiatan);
            const hariNama = getDayName(tanggalKegiatan);

            const previewHariTanggal = document.getElementById('preview-hari-tanggal');
            if (previewHariTanggal) previewHariTanggal.innerText = `${hariNama}, ${tglLengkap}`;

            const previewTujuan = document.getElementById('preview-tujuan-kegiatan');
            if (previewTujuan) previewTujuan.innerText = tujuan;

            const previewProgramTitle = document.getElementById('preview-program-title');
            if (previewProgramTitle) previewProgramTitle.innerText = programVal === 'PKL' ? 'PRAKTIK KERJA LAPANGAN (PKL)' : 'BELAJAR DI DUDI';

            const previewProgramBadge = document.getElementById('preview-program-badge');
            if (previewProgramBadge) previewProgramBadge.innerText = programVal === 'PKL' ? 'PKL (Praktik Kerja Lapangan)' : 'BELAJAR DI DUDI';

            const previewNamaDudi = document.getElementById('preview-namaDudi');
            if (previewNamaDudi) previewNamaDudi.innerText = namaDudi;

            const previewAlamatDudi = document.getElementById('preview-alamatDudi');
            if (previewAlamatDudi) previewAlamatDudi.innerText = alamatDudi;

            const previewCatatan = document.getElementById('preview-catatan');
            if (previewCatatan) previewCatatan.innerText = catatan;

            const previewNamaInstruktur = document.getElementById('preview-namaInstruktur');
            if (previewNamaInstruktur) previewNamaInstruktur.innerText = namaInstruktur;

            const previewLokasiTanggal = document.getElementById('preview-lokasi-tanggal');
            if (previewLokasiTanggal) previewLokasiTanggal.innerText = `${kotaTerbit}, ${tglLengkap}`;

            const previewNamaPembimbing = document.getElementById('preview-namaPembimbing');
            if (previewNamaPembimbing) previewNamaPembimbing.innerText = namaPembimbing;

            const previewNipGuru = document.getElementById('preview-nipGuru');
            if (previewNipGuru) previewNipGuru.innerText = nipGuru ? `NIP. ${nipGuru}` : '';

            // Update QR Code
            const previewQrCode = document.getElementById('preview-qr-code');
            if (previewQrCode) {
                const qrContent = encodeURIComponent(`SMKN1BEBANDEM|${nomorSurat}|${namaDudi}|${tanggalKegiatan}`);
                previewQrCode.src = `https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=${qrContent}`;
            }

            const previewDocHash = document.getElementById('preview-doc-hash');
            if (previewDocHash) {
                const hashVal = Math.abs((nomorSurat + namaDudi).split('').reduce((a,b)=>{a=((a<<5)-a)+b.charCodeAt(0);return a&a},0));
                previewDocHash.innerText = `BA-2026-${hashVal.toString().slice(0, 5)}`;
            }

            // Signatures preview
            const imgInstruktur = document.getElementById('preview-img-instruktur');
            const emptyInstruktur = document.getElementById('preview-empty-instruktur');
            if (signatureData.instruktur) {
                imgInstruktur.src = signatureData.instruktur;
                imgInstruktur.classList.remove('hidden');
                if (emptyInstruktur) emptyInstruktur.classList.add('hidden');
            } else {
                imgInstruktur.classList.add('hidden');
                if (emptyInstruktur) emptyInstruktur.remove('hidden');
            }

            const imgPembimbing = document.getElementById('preview-img-pembimbing');
            const emptyPembimbing = document.getElementById('preview-empty-pembimbing');
            if (signatureData.pembimbing) {
                imgPembimbing.src = signatureData.pembimbing;
                imgPembimbing.classList.remove('hidden');
                if (emptyPembimbing) emptyPembimbing.classList.add('hidden');
            } else {
                imgPembimbing.classList.add('hidden');
                if (emptyPembimbing) emptyPembimbing.remove('hidden');
            }
        }

        function resetForm() {
            document.getElementById('beritaAcaraForm').reset();
            clearSignature('instruktur');
            clearSignature('pembimbing');
            updateLivePreview();
            showToast('Formulir berhasil dikosongkan kembali', 'Form Reset', 'info');
        }

        async function downloadAsImage() {
            updateLivePreview();
            const element = document.getElementById('pdf-document-paper');
            if (!element) return;

            try {
                if (typeof html2canvas !== 'undefined') {
                    showToast('Mengolah gambar dokumen A4 resolusi tinggi...', 'Proses Unduh', 'info');
                    const canvas = await html2canvas(element, {
                        scale: 2.5,
                        useCORS: true,
                        backgroundColor: '#ffffff'
                    });
                    const image = canvas.toDataURL('image/png');
                    const link = document.createElement('a');
                    link.download = `Berita_Acara_PKL_${Date.now()}.png`;
                    link.href = image;
                    link.click();
                    showToast('Gambar Berita Acara berhasil diunduh (PNG)!', 'Sukses', 'success');
                } else {
                    showToast('Pustaka pengolah gambar sedang disiapkan, coba lagi sebentar.', 'Tunggu', 'warning');
                }
            } catch (err) {
                console.error('Failed to export image:', err);
                showToast('Gagal mengunduh gambar.', 'Peringatan', 'warning');
            }
        }

        function saveHistoryToStorage() {
            try {
                localStorage.setItem('beritaAcaraHistory', JSON.stringify(historyRecords));
                const countEl = document.getElementById('history-count');
                if (countEl) countEl.innerText = historyRecords.length;
            } catch (e) {
                console.error('Failed to save history:', e);
            }
        }

        function loadHistoryFromStorage() {
            try {
                const saved = localStorage.getItem('beritaAcaraHistory');
                if (saved) {
                    historyRecords = JSON.parse(saved);
                    const countEl = document.getElementById('history-count');
                    if (countEl) countEl.innerText = historyRecords.length;
                    renderHistoryTable();
                }
            } catch (e) {
                console.error('Failed to load history:', e);
            }
        }

        function renderHistoryTable() {
            const tbody = document.getElementById('historyTableBody');
            if (!tbody) return;

            if (historyRecords.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="p-6 text-center text-slate-500 italic">
                            Belum ada riwayat berita acara tersimpan.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = historyRecords.map(item => `
                <tr class="hover:bg-slate-900/50 transition-colors">
                    <td class="p-3 font-mono text-xs">${item.tanggal || '-'}</td>
                    <td class="p-3"><span class="px-2 py-0.5 text-xs font-semibold rounded bg-emerald-950 text-emerald-400 border border-emerald-800">${item.program || 'PKL'}</span></td>
                    <td class="p-3 font-semibold text-white">${item.namaDudi || '-'}</td>
                    <td class="p-3 text-xs text-slate-300">${item.namaGuru || '-'}</td>
                    <td class="p-3 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <button onclick="loadRecordToForm(${item.id})" class="px-2.5 py-1 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-700/50 rounded text-xs transition-all">
                                <i class="fa-solid fa-eye"></i> Lihat
                            </button>
                            <button onclick="deleteRecord(${item.id})" class="px-2 py-1 bg-rose-600/20 hover:bg-rose-600/30 text-rose-300 border border-rose-700/50 rounded text-xs transition-all">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function loadRecordToForm(id) {
            const item = historyRecords.find(r => r.id === id);
            if (!item) return;

            document.getElementById('namaGuru').value = item.namaGuru;
            if (item.nipGuru) document.getElementById('nipGuru').value = item.nipGuru;
            document.getElementById('program').value = item.program;
            document.getElementById('nomorSurat').value = item.nomorSurat;
            document.getElementById('tanggalKegiatan').value = item.tanggal;
            document.getElementById('tujuan').value = item.tujuan;
            document.getElementById('namaDudi').value = item.namaDudi;
            document.getElementById('alamatDudi').value = item.alamatDudi;
            document.getElementById('catatan').value = item.catatan;
            document.getElementById('namaInstruktur').value = item.namaInstruktur;
            document.getElementById('namaPembimbing').value = item.namaPembimbing;

            signatureData.instruktur = item.sigInstruktur;
            signatureData.pembimbing = item.sigPembimbing;

            updateLivePreview();
            switchTab('preview');
        }

        function deleteRecord(id) {
            historyRecords = historyRecords.filter(r => r.id !== id);
            saveHistoryToStorage();
            renderHistoryTable();
        }

        function closeModal() {
            document.getElementById('modalSuccess').classList.add('hidden');
        }

        document.addEventListener('DOMContentLoaded', () => {
            initCanvas('canvas-instruktur', 'instruktur');
            initCanvas('canvas-pembimbing', 'pembimbing');

            const namaGuruInput = document.getElementById('namaGuru');
            const namaPembimbingInput = document.getElementById('namaPembimbing');
            if (namaGuruInput && namaPembimbingInput) {
                namaGuruInput.addEventListener('input', (e) => {
                    if (!namaPembimbingInput.dataset.userEdited) {
                        namaPembimbingInput.value = e.target.value;
                    }
                    updateLivePreview();
                });
                namaPembimbingInput.addEventListener('input', () => {
                    namaPembimbingInput.dataset.userEdited = 'true';
                    updateLivePreview();
                });
            }

            const formInputs = document.querySelectorAll('#beritaAcaraForm input, #beritaAcaraForm select, #beritaAcaraForm textarea');
            formInputs.forEach(input => {
                input.addEventListener('input', updateLivePreview);
                input.addEventListener('change', updateLivePreview);
            });

            loadHistoryFromStorage();
            fillSampleData();
        });
    </script>
