                    </div>
                </div>

                <!-- Section 4: Digital Signatures -->
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 md:p-6 shadow-xl relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-1.5 h-full bg-indigo-500"></div>
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-file-signature text-indigo-400"></i>
                            <h2 class="text-base font-bold text-white uppercase tracking-wider">Tanda Tangan Digital</h2>
                        </div>
                        <span class="text-xs text-slate-400 bg-slate-800 px-2.5 py-1 rounded-full">Gunakan Mouse / Layar Sentuh</span>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        
                        <!-- Instruktur DUDI -->
