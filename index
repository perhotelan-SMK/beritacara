        }
        .sig-canvas.active {
            border-color: #22c55e;
            background-color: #1e293b;
        }

        /* Printable Document Dimensions & Aesthetics */
        .a4-paper {
            width: 210mm;
            min-height: 297mm;
            background: #ffffff;
            color: #0f172a;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            margin: 0 auto;
            padding: 12mm 15mm 15mm 15mm;
            box-sizing: border-box;
            font-family: 'Times New Roman', Times, serif;
            position: relative;
            overflow: hidden;
        }

        /* Document Ornate Border Frame */
        .doc-border-frame {
            border: 2px solid #0f172a;
            padding: 4px;
            height: 100%;
            position: relative;
        }

        .doc-border-inner {
            border: 1px solid #94a3b8;
            padding: 16px 20px;
            min-height: 260mm;
            position: relative;
            background: #ffffff;
        }

        /* Subtle Background Watermark */
        .doc-watermark {
            position: absolute;
            top: 52%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 320px;
            height: 320px;
            opacity: 0.04;
            pointer-events: none;
            z-index: 0;
        }

        /* Toast Notification Styling */
        #custom-toast {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 880px) {
            .a4-container {
                overflow-x: auto;
            }
        }
