                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Catatan Monitoring -->
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 md:p-6 shadow-xl relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-1.5 h-full bg-cyan-500"></div>
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-clipboard-list text-cyan-400"></i>
                            <h2 class="text-base font-bold text-white uppercase tracking-wider">Catatan Monitoring</h2>
                        </div>
                        <span class="text-[11px] text-slate-400 font-mono">BAGIAN 03</span>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
