            <form id="beritaAcaraForm" onsubmit="event.preventDefault(); handleKirim();" class="space-y-6">
                
                <!-- Section 1: Informasi Guru & Program -->
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 md:p-6 shadow-xl relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-1.5 h-full bg-emerald-500"></div>
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
