        // PDF & Image Generators
        async function downloadAsImage() {
            updateLivePreview();
            const element = document.getElementById('pdf-document-paper');
            if (!element) return;

            try {
                if (typeof html2canvas !== 'undefined') {
                    const canvas = await html2canvas(element, {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: '#ffffff'
                    });
                    const image = canvas.toDataURL('image/png');
                    const link = document.createElement('a');
                    link.download = `Berita_Acara_PKL_${Date.now()}.png`;
                    link.href = image;
                    link.click();
                } else {
                    window.print();
                }
            } catch (err) {
                console.error('Failed to export image:', err);
                window.print();
            }
        }

        async function generateAndPrintPDF() {
            updateLivePreview();
            const element = document.getElementById('pdf-document-paper');
            if (!element) return;

            const opt = {
                margin:       [8, 10, 10, 10],
                filename:     `Berita_Acara_PKL_${Date.now()}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, logging: false },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            try {
                if (typeof html2pdf !== 'undefined') {
                    await html2pdf().set(opt).from(element).save();
                } else {
                    window.print();
                }
            } catch (err) {
                console.warn('PDF fallback to print:', err);
                window.print();
            }
        }

