            if (hashElem) hashElem.innerText = refCode;

            try {
                if (typeof QRCode !== 'undefined') {
                    qrCodeObj = new QRCode(qrElem, {
                        text: payload,
                        width: 46,
                        height: 46,
                        colorDark : "#0f172a",
                        colorLight : "#ffffff",
                        correctLevel : QRCode.CorrectLevel.M
